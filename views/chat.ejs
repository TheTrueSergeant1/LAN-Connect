<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content">
    <title>LAN-Cord</title>
    
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#000000">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/socket.io/socket.io.js"></script>

    <style>
        /* --- THEME VARIABLES --- */
        :root {
            --bg-dark: #000000;
            --glass-surface: rgba(20, 20, 25, 0.75);
            --glass-border: rgba(255, 255, 255, 0.1);
            --primary: #6C5DD3;
            --primary-grad: linear-gradient(135deg, #6C5DD3 0%, #8B5CF6 100%);
            --danger: #FF4757;
            --success: #2ED573;
            --anim-spring: cubic-bezier(0.34, 1.56, 0.64, 1); /* Bouncy Physics */
            --safe-top: env(safe-area-inset-top);
            --safe-btm: env(safe-area-inset-bottom);
        }

        * { box-sizing: border-box; outline: none; -webkit-tap-highlight-color: transparent; }

        body {
            margin: 0;
            background-color: var(--bg-dark);
            /* Ambient Background */
            background-image: radial-gradient(circle at 50% 30%, #1a1b2e, #000);
            color: white;
            font-family: 'Inter', sans-serif;
            height: 100dvh; /* Dynamic height handles mobile browser bars */
            display: flex;
            overflow: hidden;
        }

        /* --- SIDEBAR (Mobile: Off-Canvas, Desktop: Fixed) --- */
        #sidebar {
            width: 280px;
            background: rgba(10, 10, 12, 0.95);
            border-right: 1px solid var(--glass-border);
            display: flex; flex-direction: column;
            z-index: 50;
            transition: transform 0.4s var(--anim-spring);
        }

        .logo-area {
            padding: 25px; padding-top: calc(25px + var(--safe-top));
            font-weight: 900; font-size: 22px; letter-spacing: -1px;
            background: linear-gradient(to right, #fff, #aaa);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .nav-item {
            margin: 5px 15px; padding: 12px; border-radius: 12px;
            color: #888; font-weight: 600; font-size: 14px; cursor: pointer;
            transition: 0.2s; display: flex; align-items: center; gap: 10px;
        }
        .nav-item:hover { background: rgba(255,255,255,0.05); color: white; }
        .nav-item.active { background: rgba(255,255,255,0.1); color: white; }

        /* --- MAIN LAYOUT --- */
        #main {
            flex: 1; display: flex; flex-direction: column;
            position: relative; width: 100%;
            background: transparent;
        }

        /* Mobile Header (Visible only on small screens) */
        #mobile-header {
            height: 60px; padding: 0 20px; padding-top: var(--safe-top);
            display: none; align-items: center;
            background: rgba(10, 10, 12, 0.8); backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--glass-border); z-index: 40;
        }

        /* Sidebar Overlay */
        #overlay {
            position: absolute; inset: 0; background: rgba(0,0,0,0.6);
            z-index: 45; opacity: 0; pointer-events: none; transition: 0.3s;
            backdrop-filter: blur(2px);
        }

        /* --- CHAT AREA --- */
        #messages {
            flex: 1; overflow-y: auto; padding: 20px;
            display: flex; flex-direction: column; gap: 12px;
            scroll-behavior: smooth;
        }

        .msg-row {
            display: flex; flex-direction: column; max-width: 85%;
            animation: msgPop 0.4s var(--anim-spring);
            transform-origin: bottom left;
        }
        .self-msg { align-self: flex-end; transform-origin: bottom right; }

        .msg-bubble {
            padding: 12px 18px; border-radius: 20px; border-bottom-left-radius: 4px;
            background: rgba(255,255,255,0.08);
            font-size: 15px; line-height: 1.4; word-wrap: break-word;
            color: #e0e0e0;
        }
        .self-msg .msg-bubble {
            background: var(--primary-grad); color: white;
            border-radius: 20px; border-bottom-right-radius: 4px;
            box-shadow: 0 4px 15px rgba(108, 93, 211, 0.3);
        }

        .msg-meta { font-size: 11px; color: #666; margin: 0 0 4px 10px; font-weight: 600; }
        .self-msg .msg-meta { text-align: right; margin: 0 10px 4px 0; }

        /* Images in Chat */
        .chat-img {
            max-width: 100%; border-radius: 12px; margin-top: 5px;
            border: 1px solid var(--glass-border);
            max-height: 300px; object-fit: cover;
        }

        /* --- INPUT AREA --- */
        #input-area {
            padding: 15px; padding-bottom: calc(15px + var(--safe-btm));
            background: rgba(20,20,20,0.6); backdrop-filter: blur(15px);
            border-top: 1px solid var(--glass-border);
            display: flex; gap: 10px; align-items: center;
        }

        .glass-input {
            flex: 1; background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border);
            padding: 12px 20px; border-radius: 50px; color: white; font-size: 16px;
            transition: 0.3s;
        }
        .glass-input:focus { background: rgba(0,0,0,0.6); border-color: var(--primary); }

        .btn-circle {
            width: 44px; height: 44px; border-radius: 50%; border: none;
            background: rgba(255,255,255,0.1); color: white; font-size: 18px;
            display: flex; align-items: center; justify-content: center; cursor: pointer;
            transition: 0.2s var(--anim-spring);
        }
        .btn-circle:active { transform: scale(0.9); }

        /* --- VIDEO GRID --- */
        #video-grid {
            display: none; position: absolute; inset: 0;
            background: #050507; z-index: 30;
            flex-wrap: wrap; padding: 20px; padding-top: 80px; gap: 15px;
            align-content: flex-start; justify-content: center; overflow-y: auto;
        }
        #video-grid.active { display: flex; animation: fadeIn 0.3s ease; }

        .video-card {
            width: 100%; max-width: 400px; aspect-ratio: 4/3;
            background: #111; border-radius: 16px; overflow: hidden;
            position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border: 1px solid var(--glass-border);
            animation: msgPop 0.4s var(--anim-spring);
        }
        video { width: 100%; height: 100%; object-fit: cover; }
        
        .vid-label {
            position: absolute; bottom: 10px; left: 10px;
            background: rgba(0,0,0,0.6); padding: 4px 8px; border-radius: 6px;
            font-size: 12px; font-weight: bold;
        }

        /* --- CONTROL ISLAND --- */
        #controls {
            position: absolute; bottom: calc(20px + var(--safe-btm)); left: 50%;
            transform: translateX(-50%) translateY(200px); /* Hidden */
            background: rgba(20,20,22,0.9); backdrop-filter: blur(20px);
            padding: 10px 20px; border-radius: 60px; border: 1px solid var(--glass-border);
            display: flex; gap: 15px; transition: transform 0.5s var(--anim-spring);
            z-index: 100; box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        }
        #controls.active { transform: translateX(-50%) translateY(0); }

        /* --- MEDIA QUERIES --- */
        @media (max-width: 768px) {
            #sidebar { position: absolute; top: 0; bottom: 0; left: 0; transform: translateX(-100%); }
            #sidebar.open { transform: translateX(0); }
            #mobile-header { display: flex; }
            #overlay.active { opacity: 1; pointer-events: all; }
            /* Fix video card sizing on mobile */
            .video-card { width: 100%; aspect-ratio: 3/4; max-width: none; } 
        }

        @keyframes msgPop { from { opacity: 0; transform: translateY(20px) scale(0.9); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

    <div id="sidebar">
        <div class="logo-area">LAN-Cord</div>
        
        <div style="flex: 1; padding: 10px 0; overflow-y: auto;">
            <div style="padding: 0 20px; color: #666; font-size: 11px; font-weight: 800; letter-spacing: 1px; margin-bottom: 5px;">TEXT</div>
            <div class="nav-item active" onclick="toggleSidebar()"><i class="fas fa-hashtag"></i> general</div>

            <div style="padding: 0 20px; color: #666; font-size: 11px; font-weight: 800; letter-spacing: 1px; margin-top: 25px; margin-bottom: 5px;">VOICE</div>
            <div class="nav-item" onclick="joinVoice()"><i class="fas fa-volume-high"></i> Lounge</div>
            <div id="voice-users" style="padding: 0 45px;"></div>
        </div>

        <div style="padding: 20px; border-top: 1px solid var(--glass-border); display: flex; align-items: center; background: rgba(0,0,0,0.3);">
            <div style="width: 36px; height: 36px; background: var(--primary-grad); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                <%= username.charAt(0).toUpperCase() %>
            </div>
            <div style="margin-left: 10px;">
                <div style="font-weight: 600; font-size: 14px;"><%= username %></div>
                <div style="font-size: 11px; color: var(--success);">● Online</div>
            </div>
        </div>
    </div>

    <div id="overlay" onclick="toggleSidebar()"></div>

    <div id="main">
        <div id="mobile-header">
            <i class="fas fa-bars" onclick="toggleSidebar()" style="font-size: 20px; padding: 10px;"></i>
            <span style="font-weight: 800; margin-left: 10px;">#general</span>
        </div>

        <div id="video-grid"></div>

        <div id="messages">
            <div style="text-align: center; font-size: 11px; color: #444; font-weight: 700; letter-spacing: 1px; margin: 20px 0;">START OF HISTORY</div>
            
            <% messages.forEach(function(msg) { %>
                <% const isSelf = msg.username === username; %>
                <div class="msg-row <%= isSelf ? 'self-msg' : '' %>">
                    <div class="msg-meta"><%= !isSelf ? msg.username : '' %></div>
                    <div class="msg-bubble">
                        <% if (msg.type === 'text') { %>
                            <%= msg.content %>
                        <% } else if (msg.type === 'file') { %>
                            <% let f = {}; try { f = JSON.parse(msg.content); } catch(e) { f = {filename:'#', originalName:'Error'}; } %>
                            <% const isImg = f.filename.match(/\.(jpg|jpeg|png|gif|webp)$/i); %>
                            
                            <% if(isImg) { %>
                                <a href="/uploads/<%= f.filename %>" target="_blank"><img src="/uploads/<%= f.filename %>" class="chat-img"></a>
                            <% } else { %>
                                <a href="/uploads/<%= f.filename %>" target="_blank" style="color: inherit; text-decoration: underline; display: flex; align-items: center; gap: 8px;">
                                    <i class="fas fa-file-arrow-down"></i> <%= f.originalName %>
                                </a>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>

        <div id="input-area">
            <input type="file" id="fileInput" style="display:none" onchange="uploadFile()">
            <button class="btn-circle" onclick="document.getElementById('fileInput').click()"><i class="fas fa-plus"></i></button>
            
            <input id="msgInput" class="glass-input" placeholder="Message #general..." autocomplete="off">
            
            <button class="btn-circle" style="background: var(--primary)" onclick="sendMsg()">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>

        <div id="controls">
            <button class="btn-circle" id="btn-cam" onclick="toggleCam()"><i class="fas fa-video"></i></button>
            <button class="btn-circle" id="btn-mic" onclick="toggleMic()"><i class="fas fa-microphone"></i></button>
            <button class="btn-circle" style="background: rgba(255, 71, 87, 0.2); color: var(--danger);" onclick="leaveVoice()"><i class="fas fa-phone-slash"></i></button>
        </div>
    </div>

    <script>
        // --- CONFIG & INIT ---
        const socket = io();
        const username = "<%= username %>";
        const msgs = document.getElementById('messages');
        
        // Scroll to bottom initially
        msgs.scrollTop = msgs.scrollHeight;

        // Register Service Worker for PWA
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.log(err));
        }

        // --- CONNECTION LOGIC (Fixes "Undefined User" bug) ---
        socket.on('connect', () => {
            console.log("Connected via Socket.io");
            socket.emit('join', username); // Re-announce identity
        });

        // --- UI LOGIC ---
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('active');
        }

        // --- CHAT LOGIC ---
        function sendMsg() {
            const input = document.getElementById('msgInput');
            if(input.value.trim()) {
                socket.emit('chat-msg', input.value);
                input.value = '';
                input.focus();
            }
        }
        document.getElementById('msgInput').addEventListener('keypress', e => { if(e.key === 'Enter') sendMsg(); });

        // Receive Message
        socket.on('chat-msg', (data) => {
            const div = document.createElement('div');
            const isSelf = data.user === username;
            div.className = `msg-row ${isSelf ? 'self-msg' : ''}`;
            
            let content = data.text;
            if (data.type === 'file') {
                const isImg = data.text.filename.match(/\.(jpg|jpeg|png|gif|webp)$/i);
                if(isImg) {
                    content = `<a href="/uploads/${data.text.filename}" target="_blank"><img src="/uploads/${data.text.filename}" class="chat-img"></a>`;
                } else {
                    content = `<a href="/uploads/${data.text.filename}" target="_blank" style="color:inherit; display:flex; gap:8px;"><i class="fas fa-file"></i> ${data.text.originalName}</a>`;
                }
            }

            div.innerHTML = `<div class="msg-meta">${!isSelf ? data.user : ''}</div><div class="msg-bubble">${content}</div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        });

        // --- FILE UPLOAD LOGIC (Robust) ---
        async function uploadFile() {
            const input = document.getElementById('fileInput');
            if(input.files.length === 0) return;

            const formData = new FormData();
            formData.append('file', input.files[0]);

            // Optimistic UI: Could add a "Uploading..." spinner here
            try {
                const res = await fetch('/upload', { method: 'POST', body: formData });
                if(!res.ok) throw new Error("Upload Failed");
                const data = await res.json();
                socket.emit('file-share', data);
            } catch(err) {
                alert("Error uploading: " + err.message);
            }
            input.value = '';
        }

        // --- WEBRTC / VOICE LOGIC ---
        let localStream;
        let peers = {};

        // Listen for who is in the lounge
        socket.on('update-voice-list', (users) => {
            const list = document.getElementById('voice-users');
            list.innerHTML = users.map(u => `<div style="color:#aaa; font-size:12px; margin-top:5px;"><i class="fas fa-circle" style="font-size:6px; color:#2ED573; margin-right:5px;"></i> ${u}</div>`).join('');
        });

        async function joinVoice() {
            // Close sidebar on mobile
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('overlay').classList.remove('active');

            try {
                localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: true });
                
                // Show UI
                document.getElementById('video-grid').classList.add('active');
                document.getElementById('controls').classList.add('active');

                // Add My Video
                addVideo(localStream, username, true, 'me');

                // Signal Server
                socket.emit('join-voice');
                socket.emit('signal', { type: 'join-req', target: null });

            } catch(e) {
                alert("Could not access Camera/Mic. Please allow permissions.");
            }
        }

        function leaveVoice() {
            if(localStream) localStream.getTracks().forEach(t => t.stop());
            localStream = null;
            
            // Close all peer connections
            Object.values(peers).forEach(pc => pc.close());
            peers = {};

            document.getElementById('video-grid').classList.remove('active');
            document.getElementById('controls').classList.remove('active');
            document.getElementById('video-grid').innerHTML = ''; // Clear videos
            
            socket.emit('leave-voice');
        }

        function toggleCam() {
            if(!localStream) return;
            const vidTrack = localStream.getVideoTracks()[0];
            if(vidTrack) {
                vidTrack.enabled = !vidTrack.enabled;
                document.getElementById('btn-cam').style.color = vidTrack.enabled ? 'white' : '#FF4757';
                // Note: In full production, we'd re-signal "mute" state, but video stops transmitting automatically
            }
        }

        function toggleMic() {
            if(!localStream) return;
            const audTrack = localStream.getAudioTracks()[0];
            if(audTrack) {
                audTrack.enabled = !audTrack.enabled;
                document.getElementById('btn-mic').style.color = audTrack.enabled ? 'white' : '#FF4757';
                document.getElementById('btn-mic').innerHTML = audTrack.enabled ? '<i class="fas fa-microphone"></i>' : '<i class="fas fa-microphone-slash"></i>';
            }
        }

        // --- PEER CONNECTION HELPERS ---
        function createPeer(targetId, targetUser) {
            const pc = new RTCPeerConnection({
                iceServers: [] // LAN only, no STUN needed usually
            });

            // Add local tracks
            if(localStream) {
                localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
            }

            // Handle ICE Candidates
            pc.onicecandidate = e => {
                if(e.candidate) socket.emit('signal', { type: 'candidate', candidate: e.candidate, target: targetId });
            };

            // Handle Incoming Stream
            pc.ontrack = e => {
                addVideo(e.streams[0], targetUser, false, targetId);
            };

            // Negotiation (Needed if we add/remove tracks later)
            pc.onnegotiationneeded = async () => {
                try {
                    const offer = await pc.createOffer();
                    await pc.setLocalDescription(offer);
                    socket.emit('signal', { type: 'offer', sdp: offer, target: targetId });
                } catch(e) { console.error(e); }
            };

            return pc;
        }

        function addVideo(stream, name, muted, id) {
            // Remove existing if exists
            const existing = document.getElementById(`vid-${id}`);
            if(existing) existing.remove();

            const card = document.createElement('div');
            card.className = 'video-card';
            card.id = `vid-${id}`;

            const vid = document.createElement('video');
            vid.srcObject = stream;
            vid.autoplay = true;
            vid.playsInline = true; // Critical for iOS
            if(muted) vid.muted = true;

            const label = document.createElement('div');
            label.className = 'vid-label';
            label.innerText = name;

            card.appendChild(vid);
            card.appendChild(label);
            document.getElementById('video-grid').appendChild(card);
        }

        // --- SIGNALING HANDLER ---
        socket.on('signal', async (d) => {
            if(d.senderUser === username) return;

            // Create peer if doesn't exist
            if(!peers[d.senderId]) {
                peers[d.senderId] = createPeer(d.senderId, d.senderUser);
            }
            const pc = peers[d.senderId];

            try {
                if (d.type === 'join-req') {
                    const offer = await pc.createOffer();
                    await pc.setLocalDescription(offer);
                    socket.emit('signal', { type: 'offer', sdp: offer, target: d.senderId });
                } 
                else if (d.type === 'offer') {
                    await pc.setRemoteDescription(d.sdp);
                    const answer = await pc.createAnswer();
                    await pc.setLocalDescription(answer);
                    socket.emit('signal', { type: 'answer', sdp: answer, target: d.senderId });
                } 
                else if (d.type === 'answer') {
                    await pc.setRemoteDescription(d.sdp);
                } 
                else if (d.type === 'candidate') {
                    await pc.addIceCandidate(d.candidate);
                }
            } catch(e) { console.error("WebRTC Error:", e); }
        });

        socket.on('user-left-voice', (id) => {
            if(peers[id]) {
                peers[id].close();
                delete peers[id];
            }
            const el = document.getElementById(`vid-${id}`);
            if(el) el.remove();
            
            // If no one left, maybe hide grid? Optional.
            if(document.getElementById('video-grid').children.length === 0) {
                // document.getElementById('video-grid').classList.remove('active');
            }
        });

    </script>
</body>
</html>