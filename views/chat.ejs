<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>LAN-Cord Premium</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        /* --- THE PREMIUM THEME --- */
        :root {
            --bg-dark: #050507;
            --glass-surface: rgba(20, 20, 25, 0.65);
            --glass-strong: rgba(20, 20, 25, 0.85);
            --glass-border: rgba(255, 255, 255, 0.08);
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --accent-glow: 0 0 20px rgba(118, 75, 162, 0.5);
            --text-main: #ffffff;
            --text-muted: #a0a0b0;
            --anim-curve: cubic-bezier(0.2, 0.8, 0.2, 1);
            --danger: #ff4757;
            --success: #2ed573;
        }

        * { box-sizing: border-box; outline: none; }
        
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            /* The Mesh Gradient Background */
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(118, 75, 162, 0.15), transparent 25%), 
                radial-gradient(circle at 85% 30%, rgba(102, 126, 234, 0.15), transparent 25%);
            color: var(--text-main);
            height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* --- MAIN FLOATING CONTAINER --- */
        #app-container {
            width: 95vw;
            height: 92vh;
            display: flex;
            background: var(--glass-surface);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            animation: scaleIn 0.8s var(--anim-curve);
            position: relative;
        }

        /* --- SIDEBAR (Discord Layout, Glass Style) --- */
        #sidebar {
            width: 260px;
            background: rgba(0,0,0,0.2); /* Semi-transparent */
            border-right: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
        }

        .server-header {
            height: 60px;
            padding: 0 20px;
            font-weight: 800;
            font-size: 18px;
            border-bottom: 1px solid var(--glass-border);
            display: flex; align-items: center; justify-content: space-between;
            background: linear-gradient(to right, #fff, #ccc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }

        .channel-group { flex: 1; padding: 20px 10px; overflow-y: auto; }
        
        .channel-label {
            font-size: 10px; font-weight: 700; color: var(--text-muted); 
            text-transform: uppercase; margin-bottom: 10px; padding-left: 10px;
            letter-spacing: 1px;
        }

        .channel-btn {
            display: flex; align-items: center;
            width: 100%; padding: 10px 12px; margin-bottom: 4px;
            border-radius: 8px; border: none; background: transparent;
            color: var(--text-muted); cursor: pointer;
            font-weight: 500; font-size: 14px;
            transition: all 0.2s var(--anim-curve);
        }
        .channel-btn:hover { background: rgba(255,255,255,0.05); color: #fff; transform: translateX(5px); }
        .channel-btn.active { background: rgba(255,255,255,0.1); color: #fff; font-weight: 600; }
        .channel-icon { margin-right: 10px; opacity: 0.7; }

        /* Voice Users List */
        #voice-users { margin-left: 28px; margin-top: 5px; border-left: 1px solid var(--glass-border); padding-left: 10px; }
        .voice-user {
            display: flex; align-items: center;
            padding: 6px 0; font-size: 13px; color: #fff;
            animation: slideRight 0.3s var(--anim-curve);
        }
        .voice-avatar {
            width: 20px; height: 20px; border-radius: 50%; 
            background: var(--primary-gradient); margin-right: 8px;
            display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: bold;
        }

        /* --- USER DOCK (Bottom Left) --- */
        .user-dock {
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(10px);
            padding: 15px;
            display: flex; align-items: center;
            border-top: 1px solid var(--glass-border);
        }
        .dock-avatar {
            width: 36px; height: 36px; border-radius: 50%; 
            background: var(--primary-gradient);
            margin-right: 10px; position: relative;
            display: flex; align-items: center; justify-content: center; font-weight: bold;
        }
        .dock-status {
            width: 10px; height: 10px; background: var(--success); border-radius: 50%;
            position: absolute; bottom: 0; right: 0; border: 2px solid #1a1a1a;
            box-shadow: 0 0 10px var(--success);
        }
        .dock-info { flex: 1; font-size: 13px; font-weight: 600; }
        .dock-sub { font-size: 10px; color: var(--text-muted); opacity: 0.7; }
        .dock-btn {
            background: transparent; border: none; color: white; opacity: 0.7;
            cursor: pointer; padding: 8px; border-radius: 8px; transition: 0.2s;
        }
        .dock-btn:hover { background: rgba(255,255,255,0.1); opacity: 1; }

        /* --- MAIN CONTENT --- */
        #main {
            flex: 1; display: flex; flex-direction: column;
            position: relative;
        }

        /* Video Grid (Overlay) */
        #video-grid {
            display: none;
            flex: 1;
            padding: 20px;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            align-items: center;
            overflow-y: auto;
            animation: fadeIn 0.5s ease;
        }
        #video-grid.active { display: flex; }

        .video-card {
            position: relative;
            background: #000;
            border-radius: 16px;
            overflow: hidden;
            width: 320px; height: 240px; 
            border: 1px solid var(--glass-border);
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            animation: popIn 0.4s var(--anim-curve);
        }
        .video-card video { width: 100%; height: 100%; object-fit: cover; }
        .video-label {
            position: absolute; bottom: 12px; left: 12px;
            background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
            color: white; padding: 4px 10px; border-radius: 6px; 
            font-size: 12px; font-weight: 600;
        }

        /* Chat Area */
        #chat-area { flex: 1; display: flex; flex-direction: column; height: 100%; }
        #messages { flex: 1; overflow-y: auto; padding: 30px; display: flex; flex-direction: column; gap: 15px; }
        
        /* Message Bubbles (Premium Style) */
        .msg-row { display: flex; flex-direction: column; max-width: 70%; opacity: 0; animation: slideUp 0.4s var(--anim-curve) forwards; }
        .msg-bubble {
            padding: 12px 18px; border-radius: 18px; border-top-left-radius: 4px;
            background: rgba(255,255,255,0.05); color: #dcddde;
            line-height: 1.5; font-size: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .msg-meta { margin-left: 10px; margin-bottom: 4px; font-size: 11px; color: var(--text-muted); }
        .msg-meta strong { color: white; font-weight: 600; font-size: 13px; margin-right: 6px; }

        /* Self Message Styling */
        .self-msg { align-self: flex-end; }
        .self-msg .msg-bubble {
            background: var(--primary-gradient); color: white;
            border-top-left-radius: 18px; border-top-right-radius: 4px;
            box-shadow: var(--accent-glow);
        }
        .self-msg .msg-meta { text-align: right; margin-right: 10px; }

        /* Input Area */
        #input-area { 
            padding: 20px 30px; margin-bottom: 10px;
            display: flex; align-items: center; gap: 15px;
        }
        .pill-input {
            flex: 1; background: rgba(0,0,0,0.3);
            border: 1px solid var(--glass-border);
            padding: 14px 24px; border-radius: 50px;
            color: white; font-size: 15px; transition: 0.3s;
        }
        .pill-input:focus { background: rgba(0,0,0,0.5); border-color: #764ba2; box-shadow: 0 0 15px rgba(118, 75, 162, 0.2); }
        
        .action-btn {
            width: 45px; height: 45px; border-radius: 50%;
            border: none; background: rgba(255,255,255,0.1);
            color: white; cursor: pointer; transition: 0.2s;
            display: flex; align-items: center; justify-content: center;
        }
        .action-btn:hover { background: white; color: black; transform: rotate(10deg); }

        /* --- FLOATING CALL CONTROLS (Glass Pill) --- */
        #call-controls {
            position: absolute; bottom: 30px; left: 50%;
            transform: translateX(-50%) translateY(150px); /* Hidden */
            background: var(--glass-strong);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            padding: 10px 25px; border-radius: 60px;
            display: flex; gap: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.6);
            transition: transform 0.5s var(--anim-curve);
            z-index: 100;
        }
        #call-controls.active { transform: translateX(-50%) translateY(0); }

        .ctrl-btn {
            width: 55px; height: 55px; border-radius: 50%;
            border: 1px solid var(--glass-border);
            background: rgba(255,255,255,0.05);
            color: white; font-size: 20px; cursor: pointer;
            transition: 0.2s var(--anim-curve);
            display: flex; align-items: center; justify-content: center;
        }
        .ctrl-btn:hover { transform: scale(1.1); background: rgba(255,255,255,0.15); }
        .ctrl-btn.active { background: white; color: black; box-shadow: 0 0 20px rgba(255,255,255,0.5); }
        
        .ctrl-btn-danger { background: rgba(255, 71, 87, 0.2); color: var(--danger); border-color: rgba(255, 71, 87, 0.4); }
        .ctrl-btn-danger:hover { background: var(--danger); color: white; box-shadow: 0 0 20px rgba(255, 71, 87, 0.5); }

        /* Animations */
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideRight { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes popIn { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

    <div id="app-container">
        <div id="sidebar">
            <div class="server-header">LAN-Cord</div>
            
            <div class="channel-group">
                <div class="channel-label">Text Channels</div>
                <button class="channel-btn active"><i class="fas fa-hashtag channel-icon"></i> general</button>

                <div class="channel-label" style="margin-top: 25px;">Voice Channels</div>
                <button class="channel-btn" onclick="joinVoiceChannel()">
                    <i class="fas fa-volume-up channel-icon"></i> Lounge
                </button>
                <div id="voice-users"></div>
            </div>

            <div class="user-dock">
                <div class="dock-avatar">
                    <%= username.charAt(0).toUpperCase() %>
                    <div class="dock-status"></div>
                </div>
                <div class="dock-info">
                    <div><%= username %></div>
                    <div class="dock-sub">Online</div>
                </div>
                <button class="dock-btn"><i class="fas fa-microphone"></i></button>
                <button class="dock-btn"><i class="fas fa-cog"></i></button>
            </div>
        </div>

        <div id="main">
            
            <div id="video-grid"></div>

            <div id="chat-area">
                <div id="messages">
                    <div style="color: var(--text-muted); text-align: center; margin-top: 20px; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">
                        Start of #general history
                    </div>
                </div>
                <div id="input-area">
                    <button class="action-btn" onclick="document.getElementById('fileInput').click()">
                        <i class="fas fa-paperclip"></i>
                    </button>
                    <input type="file" id="fileInput" style="display:none">
                    
                    <input id="msgInput" class="pill-input" autocomplete="off" placeholder="Message #general...">
                </div>
            </div>

            <div id="call-controls">
                <button class="ctrl-btn" id="btn-cam" onclick="toggleCamera()" title="Toggle Camera">
                    <i class="fas fa-video"></i>
                </button>
                <button class="ctrl-btn" id="btn-screen" onclick="toggleScreen()" title="Share Screen">
                    <i class="fas fa-desktop"></i>
                </button>
                <button class="ctrl-btn" id="btn-mic" onclick="toggleMic()" title="Mute Mic">
                    <i class="fas fa-microphone"></i>
                </button>
                <button class="ctrl-btn ctrl-btn-danger" onclick="leaveVoiceChannel()" title="Disconnect">
                    <i class="fas fa-phone-slash"></i>
                </button>
            </div>

        </div>
    </div>

    <script>
        const socket = io();
        const username = "<%= username %>";
        
        // --- Chat Logic ---
        socket.emit('join', username);

        socket.on('chat-msg', (data) => {
            const div = document.createElement('div');
            const isSelf = data.user === username;
            div.className = `msg-row ${isSelf ? 'self-msg' : ''}`;
            
            let content = data.text;
            if (data.type === 'file') {
                content = `<a href="/uploads/${data.text.filename}" target="_blank" style="color: inherit; text-decoration: underline; display: flex; align-items: center; gap: 8px;">
                           <i class="fas fa-file-download"></i> ${data.text.originalName}</a>`;
            }

            div.innerHTML = `
                <div class="msg-meta">
                    ${!isSelf ? `<strong>${data.user}</strong>` : ''}
                    ${data.timestamp}
                </div>
                <div class="msg-bubble">${content}</div>
            `;
            const msgs = document.getElementById('messages');
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        });

        document.getElementById('msgInput').addEventListener('keypress', (e) => {
            if(e.key === 'Enter' && e.target.value.trim()) {
                socket.emit('chat-msg', e.target.value);
                e.target.value = '';
            }
        });

        // --- VOICE & VIDEO LOGIC (Same functionality, updated UI handling) ---
        
        let localStream; 
        let peers = {};  
        let isInCall = false;
        let isScreenSharing = false;

        socket.on('update-voice-list', (users) => {
            const div = document.getElementById('voice-users');
            div.innerHTML = '';
            users.forEach(u => {
                const row = document.createElement('div');
                row.className = 'voice-user';
                row.innerHTML = `<div class="voice-avatar">${u.charAt(0)}</div> ${u}`;
                div.appendChild(row);
            });
        });

        async function joinVoiceChannel() {
            if(isInCall) return;
            try {
                localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                document.getElementById('call-controls').classList.add('active');
                isInCall = true;
                socket.emit('join-voice');
                socket.emit('signal', { type: 'join-request', target: null });
                addVideoTile(localStream, username, true);
            } catch(e) { alert("Microphone permission required."); console.error(e); }
        }

        async function toggleCamera() {
            if (!localStream) return;
            const videoTrack = localStream.getVideoTracks()[0];
            if (videoTrack && videoTrack.readyState === 'live') {
                videoTrack.stop();
                localStream.removeTrack(videoTrack);
                document.getElementById('btn-cam').classList.remove('active');
                refreshMyTile();
            } else {
                if(isScreenSharing) await stopScreenShare();
                const newStream = await navigator.mediaDevices.getUserMedia({ video: true });
                const newTrack = newStream.getVideoTracks()[0];
                localStream.addTrack(newTrack);
                document.getElementById('btn-cam').classList.add('active');
                refreshMyTile();
                Object.values(peers).forEach(pc => {
                    pc.addTrack(newTrack, localStream);
                    renegotiate(pc); 
                });
            }
        }

        async function toggleScreen() {
            if (isScreenSharing) { stopScreenShare(); return; }
            try {
                const vidTrack = localStream.getVideoTracks()[0];
                if(vidTrack) {
                    vidTrack.stop();
                    localStream.removeTrack(vidTrack);
                    document.getElementById('btn-cam').classList.remove('active');
                }
                const screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
                const screenTrack = screenStream.getVideoTracks()[0];
                screenTrack.onended = () => stopScreenShare();
                localStream.addTrack(screenTrack);
                isScreenSharing = true;
                document.getElementById('btn-screen').classList.add('active');
                refreshMyTile();
                Object.values(peers).forEach(pc => {
                    pc.addTrack(screenTrack, localStream);
                    renegotiate(pc);
                });
            } catch(err) { console.log("Screen share cancelled"); }
        }

        function stopScreenShare() {
            const screenTrack = localStream.getVideoTracks()[0];
            if(screenTrack) { screenTrack.stop(); localStream.removeTrack(screenTrack); }
            isScreenSharing = false;
            document.getElementById('btn-screen').classList.remove('active');
            refreshMyTile();
        }

        function toggleMic() {
            const audioTrack = localStream.getAudioTracks()[0];
            if(audioTrack) {
                audioTrack.enabled = !audioTrack.enabled;
                const btn = document.getElementById('btn-mic');
                btn.innerHTML = audioTrack.enabled ? '<i class="fas fa-microphone"></i>' : '<i class="fas fa-microphone-slash"></i>';
                btn.style.color = audioTrack.enabled ? 'white' : '#ff4757';
            }
        }

        function leaveVoiceChannel() {
            if(localStream) localStream.getTracks().forEach(t => t.stop());
            localStream = null;
            isInCall = false;
            Object.values(peers).forEach(pc => pc.close());
            peers = {};
            document.getElementById('video-grid').innerHTML = '';
            document.getElementById('video-grid').classList.remove('active');
            document.getElementById('chat-area').style.display = 'flex';
            document.getElementById('call-controls').classList.remove('active');
            socket.emit('leave-voice');
        }

        // --- WebRTC Core ---
        async function renegotiate(pc) {
            const offer = await pc.createOffer();
            await pc.setLocalDescription(offer);
        }

        socket.on('signal', async (data) => {
            if (data.senderUser === username) return;
            const peerId = data.senderId;
            if (!peers[peerId]) peers[peerId] = createPeer(peerId, data.senderUser);
            const pc = peers[peerId];

            if (data.type === 'join-request') {
                const offer = await pc.createOffer();
                await pc.setLocalDescription(offer);
                socket.emit('signal', { type: 'offer', sdp: offer, target: peerId });
            }
            else if (data.type === 'offer') {
                await pc.setRemoteDescription(data.sdp);
                const answer = await pc.createAnswer();
                await pc.setLocalDescription(answer);
                socket.emit('signal', { type: 'answer', sdp: answer, target: peerId });
            }
            else if (data.type === 'answer') await pc.setRemoteDescription(data.sdp);
            else if (data.type === 'candidate') pc.addIceCandidate(data.candidate);
        });

        socket.on('user-left-voice', (id) => {
            if(peers[id]) { peers[id].close(); delete peers[id]; }
            const el = document.getElementById(`video-${id}`);
            if(el) el.remove();
            if(document.getElementById('video-grid').children.length === 0) {
               document.getElementById('video-grid').classList.remove('active');
               document.getElementById('chat-area').style.display = 'flex';
            }
        });

        function createPeer(targetId, targetUser) {
            const pc = new RTCPeerConnection({ iceServers: [] });
            if (localStream) localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
            pc.onicecandidate = (e) => { if(e.candidate) socket.emit('signal', { type: 'candidate', candidate: e.candidate, target: targetId }); };
            pc.ontrack = (e) => { addVideoTile(e.streams[0], targetUser, false, targetId); };
            pc.onnegotiationneeded = async () => {
                const offer = await pc.createOffer();
                await pc.setLocalDescription(offer);
                socket.emit('signal', { type: 'offer', sdp: offer, target: targetId });
            };
            return pc;
        }

        function addVideoTile(stream, name, isMuted, id = 'me') {
            const grid = document.getElementById('video-grid');
            if (!grid.classList.contains('active')) {
                grid.classList.add('active');
                document.getElementById('chat-area').style.display = 'none';
            }
            const exist = document.getElementById(`video-${id}`);
            if(exist) exist.remove();

            const card = document.createElement('div');
            card.className = 'video-card';
            card.id = `video-${id}`;
            
            const vid = document.createElement('video');
            vid.srcObject = stream;
            vid.autoplay = true;
            if(isMuted) vid.muted = true;

            const label = document.createElement('div');
            label.className = 'video-label';
            label.innerText = name;

            card.appendChild(vid);
            card.appendChild(label);
            grid.appendChild(card);
        }
        function refreshMyTile() { addVideoTile(localStream, username, true); }
    </script>
</body>
</html>