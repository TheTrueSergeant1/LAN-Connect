<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>LAN-Cord Premium</title>
    
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="LAN-Cord">
    <link rel="apple-touch-icon" href="/icons/icon.png">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <script src="/socket.io/socket.io.js"></script>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(e => console.log(e));
        }
    </script>

    <style>
        :root {
            --bg-dark: #050507;
            --glass-surface: rgba(20, 20, 25, 0.65);
            --glass-strong: rgba(15, 15, 20, 0.95);
            --glass-border: rgba(255, 255, 255, 0.08);
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --accent-glow: 0 0 20px rgba(118, 75, 162, 0.5);
            --text-main: #ffffff;
            --text-muted: #a0a0b0;
            --anim-curve: cubic-bezier(0.2, 0.8, 0.2, 1);
            --danger: #ff4757;
            --success: #2ed573;
            --safe-area-top: env(safe-area-inset-top);
            --safe-area-bottom: env(safe-area-inset-bottom);
        }

        * { box-sizing: border-box; outline: none; -webkit-tap-highlight-color: transparent; }
        
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(118, 75, 162, 0.15), transparent 25%), 
                radial-gradient(circle at 85% 30%, rgba(102, 126, 234, 0.15), transparent 25%);
            color: var(--text-main);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* --- APP CONTAINER --- */
        #app-container {
            width: 95vw;
            height: 92vh;
            display: flex;
            background: var(--glass-surface);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            position: relative;
            transition: all 0.3s ease;
        }

        /* --- MOBILE HEADER (Hamburger) --- */
        #mobile-header {
            display: none;
            height: 60px;
            padding: 0 20px;
            padding-top: var(--safe-area-top);
            align-items: center;
            border-bottom: 1px solid var(--glass-border);
            background: rgba(20, 20, 25, 0.6);
            backdrop-filter: blur(10px);
            position: absolute; top: 0; left: 0; right: 0; z-index: 50;
        }
        .hamburger { font-size: 24px; color: white; cursor: pointer; }
        .mobile-title { margin-left: 15px; font-weight: 800; font-size: 16px; letter-spacing: -0.5px; }

        /* --- SIDEBAR --- */
        #sidebar {
            width: 280px;
            background: rgba(0,0,0,0.2);
            border-right: 1px solid var(--glass-border);
            display: flex; flex-direction: column;
            transition: transform 0.4s var(--anim-curve);
            z-index: 100;
        }

        #sidebar-overlay {
            display: none;
            position: absolute; inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            z-index: 90;
            opacity: 0; transition: opacity 0.3s;
        }

        .server-header {
            height: 60px; padding: 0 20px; font-weight: 800; font-size: 18px;
            border-bottom: 1px solid var(--glass-border);
            display: flex; align-items: center;
            background: linear-gradient(to right, #fff, #ccc); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .channel-group { flex: 1; padding: 20px 10px; overflow-y: auto; }
        .channel-btn {
            display: flex; align-items: center; width: 100%; padding: 12px; margin-bottom: 4px;
            border-radius: 12px; border: none; background: transparent;
            color: var(--text-muted); font-weight: 500; font-size: 15px;
            transition: 0.2s var(--anim-curve); cursor: pointer;
        }
        .channel-btn.active { background: rgba(255,255,255,0.1); color: #fff; }
        
        .user-dock {
            background: rgba(0,0,0,0.3); padding: 15px; padding-bottom: calc(15px + var(--safe-area-bottom));
            display: flex; align-items: center; border-top: 1px solid var(--glass-border);
        }
        .dock-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--primary-gradient); margin-right: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold;}

        /* --- MAIN CONTENT --- */
        #main {
            flex: 1; display: flex; flex-direction: column; position: relative;
            background: transparent;
        }

        #chat-area { flex: 1; display: flex; flex-direction: column; height: 100%; position: relative; }
        
        #messages {
            flex: 1; overflow-y: auto; padding: 20px; padding-top: 70px;
            display: flex; flex-direction: column; gap: 15px;
            -webkit-overflow-scrolling: touch; 
        }

        .msg-row { display: flex; flex-direction: column; max-width: 85%; animation: slideUp 0.4s var(--anim-curve); }
        .msg-bubble {
            padding: 12px 16px; border-radius: 18px; border-top-left-radius: 4px;
            background: rgba(255,255,255,0.08); color: #eee; font-size: 15px; line-height: 1.4; word-break: break-word;
        }
        .self-msg { align-self: flex-end; }
        .self-msg .msg-bubble {
            background: var(--primary-gradient); border-top-left-radius: 18px; border-top-right-radius: 4px;
        }
        .msg-meta { margin-left: 10px; margin-bottom: 4px; font-size: 11px; color: var(--text-muted); }

        /* Input Area */
        #input-area { 
            padding: 15px; padding-bottom: calc(15px + var(--safe-area-bottom));
            display: flex; gap: 10px; align-items: center;
            background: rgba(0,0,0,0.2); backdrop-filter: blur(10px);
        }
        .pill-input {
            flex: 1; background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border);
            padding: 12px 20px; border-radius: 50px; color: white; font-size: 16px; 
        }
        .action-btn {
            width: 44px; height: 44px; border-radius: 50%; border: none;
            background: rgba(255,255,255,0.1); color: white; font-size: 18px;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
        }

        /* --- VIDEO GRID --- */
        #video-grid {
            display: none; flex: 1; padding: 20px; padding-top: 70px;
            flex-wrap: wrap; gap: 15px; justify-content: center; align-content: flex-start;
            overflow-y: auto;
        }
        #video-grid.active { display: flex; }
        .video-card {
            position: relative; background: #000; border-radius: 16px; overflow: hidden;
            width: 100%; max-width: 400px; aspect-ratio: 16/9; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.4); animation: popIn 0.4s var(--anim-curve);
        }
        .video-label {
            position: absolute; bottom: 10px; left: 10px; 
            background: rgba(0,0,0,0.6); padding: 4px 8px; border-radius: 4px; 
            font-size: 12px; font-weight: bold; z-index: 2; pointer-events: none;
        }
        video { width: 100%; height: 100%; object-fit: cover; }

        /* --- CONTROLS --- */
        #call-controls {
            position: absolute; bottom: calc(20px + var(--safe-area-bottom)); left: 50%;
            transform: translateX(-50%) translateY(200px);
            background: var(--glass-strong); backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border); padding: 10px 20px; border-radius: 60px;
            display: flex; gap: 15px; z-index: 100; transition: transform 0.5s var(--anim-curve);
            width: 90%; max-width: 350px; justify-content: space-around;
        }
        #call-controls.active { transform: translateX(-50%) translateY(0); }

        /* --- MEDIA QUERIES --- */
        @media (max-width: 768px) {
            body { background-image: none; background-color: #000; }
            
            #app-container { width: 100%; height: 100%; border-radius: 0; border: none; }

            #mobile-header { display: flex; }

            #sidebar {
                position: absolute; top: 0; bottom: 0; left: 0;
                background: #0f0f12; 
                transform: translateX(-100%);
                box-shadow: 20px 0 50px rgba(0,0,0,0.5);
            }
            #sidebar.open { transform: translateX(0); }
            #sidebar-overlay.open { display: block; opacity: 1; }

            .server-header { padding-top: var(--safe-area-top); height: calc(60px + var(--safe-area-top)); }
            .video-card { width: 100%; aspect-ratio: 4/3; }
        }

        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    </style>
</head>
<body>

    <div id="app-container">
        
        <div id="mobile-header">
            <div class="hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></div>
            <div class="mobile-title">#general</div>
        </div>

        <div id="sidebar-overlay" onclick="toggleSidebar()"></div>

        <div id="sidebar">
            <div class="server-header">LAN-Cord</div>
            <div class="channel-group">
                <div style="font-size: 10px; font-weight: 700; color: #888; margin-bottom: 10px; padding-left: 10px;">TEXT CHANNELS</div>
                <button class="channel-btn active" onclick="closeSidebar()"><i class="fas fa-hashtag" style="margin-right:10px; opacity:0.7"></i> general</button>

                <div style="font-size: 10px; font-weight: 700; color: #888; margin-top: 25px; margin-bottom: 10px; padding-left: 10px;">VOICE CHANNELS</div>
                <button class="channel-btn" onclick="joinVoiceChannel()">
                    <i class="fas fa-volume-up" style="margin-right:10px; opacity:0.7"></i> Lounge
                </button>
                <div id="voice-users" style="margin-left: 20px; border-left: 1px solid #333; padding-left: 10px; margin-top: 5px;"></div>
            </div>

            <div class="user-dock">
                <div class="dock-avatar"><%= username.charAt(0).toUpperCase() %></div>
                <div style="flex:1; font-weight: 600; font-size: 14px;">
                    <%= username %>
                    <div style="font-size: 10px; color: #aaa;">Online</div>
                </div>
                <i class="fas fa-microphone" style="padding: 10px; opacity: 0.7;"></i>
                <a href="/admin" style="color: white; opacity: 0.5; margin-left: 5px;"><i class="fas fa-cog"></i></a>
            </div>
        </div>

        <div id="main">
            <div id="video-grid"></div>

            <div id="chat-area">
                <div id="messages">
                    <div style="text-align: center; color: #555; font-size: 12px; margin-top: 20px; margin-bottom: 20px;">
                        START OF HISTORY
                    </div>
                
                    <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
                        <% messages.forEach(function(msg) { %>
                            <% const isSelf = msg.username === username; %>
                            <div class="msg-row <%= isSelf ? 'self-msg' : '' %>">
                                <div class="msg-meta">
                                    <strong><%= !isSelf ? msg.username : '' %></strong>
                                    <span style="opacity:0.5; font-size:10px"><%= msg.timestamp || '' %></span>
                                </div>
                                <div class="msg-bubble">
                                    <% if (msg.type === 'text') { %>
                                        <%= msg.content %>
                                    <% } else if (msg.type === 'file') { %>
                                        <% let fileData; try { fileData = JSON.parse(msg.content); } catch(e) { fileData = {originalName: 'Error', filename: '#'}; } %>
                                        <a href="/uploads/<%= fileData.filename %>" target="_blank" style="color:inherit; text-decoration:underline; display:flex; align-items:center; gap:5px;">
                                           <i class="fas fa-file"></i> <%= fileData.originalName %>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <div id="input-area">
                    <button class="action-btn" onclick="document.getElementById('fileInput').click()">
                        <i class="fas fa-paperclip"></i>
                    </button>
                    <input type="file" id="fileInput" style="display:none">
                    <input id="msgInput" class="pill-input" autocomplete="off" placeholder="Message #general">
                    <button class="action-btn" style="background: var(--primary-gradient);" onclick="sendMsg()">
                        <i class="fas fa-arrow-up"></i>
                    </button>
                </div>
            </div>

            <div id="call-controls">
                <button class="action-btn" id="btn-cam" onclick="toggleCamera()"><i class="fas fa-video"></i></button>
                <button class="action-btn" id="btn-screen" onclick="toggleScreen()"><i class="fas fa-desktop"></i></button>
                <button class="action-btn" id="btn-mic" onclick="toggleMic()"><i class="fas fa-microphone"></i></button>
                <button class="action-btn" style="background: rgba(255, 71, 87, 0.2); color: #ff4757;" onclick="leaveVoiceChannel()"><i class="fas fa-phone-slash"></i></button>
            </div>
        </div>
    </div>

    <script>
        const socket = io();
        const username = "<%= username %>";

        // --- Sound Engine ---
        const audioCtx = {
            message: new Audio('/sounds/message.mp3'),
            join: new Audio('/sounds/join.mp3')
        };
        function playSound(type) {
            const sound = audioCtx[type];
            if (sound) {
                sound.currentTime = 0;
                sound.play().catch(e => {}); // Catch autoplay blocks
            }
        }

        // --- Mobile Sidebar Logic ---
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebar-overlay').classList.toggle('open');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebar-overlay').classList.remove('open');
        }

        // --- Chat Logic ---
        socket.emit('join', username);
        
        // Scroll to bottom on load
        const msgsBox = document.getElementById('messages');
        msgsBox.scrollTop = msgsBox.scrollHeight;

        function sendMsg() {
            const input = document.getElementById('msgInput');
            if(input.value.trim()) {
                socket.emit('chat-msg', input.value);
                input.value = '';
            }
        }

        document.getElementById('msgInput').addEventListener('keypress', (e) => {
            if(e.key === 'Enter') sendMsg();
        });

        socket.on('chat-msg', (data) => {
            if(data.user !== username) playSound('message');
            
            const div = document.createElement('div');
            const isSelf = data.user === username;
            div.className = `msg-row ${isSelf ? 'self-msg' : ''}`;
            
            let content = data.text;
            if (data.type === 'file') {
                content = `<a href="/uploads/${data.text.filename}" target="_blank" style="color:inherit; text-decoration:underline; display:flex; align-items:center; gap:5px;">
                           <i class="fas fa-file"></i> ${data.text.originalName}</a>`;
            }

            div.innerHTML = `
                <div class="msg-meta">
                    <strong>${!isSelf ? data.user : ''}</strong>
                    <span style="opacity:0.5; font-size:10px">${data.timestamp}</span>
                </div>
                <div class="msg-bubble">${content}</div>
            `;
            msgsBox.appendChild(div);
            msgsBox.scrollTop = msgsBox.scrollHeight;
        });

        // File Upload
        document.getElementById('fileInput').addEventListener('change', async (e) => {
            if(e.target.files.length === 0) return;
            const file = e.target.files[0];
            const formData = new FormData();
            formData.append('file', file);
            const res = await fetch('/upload', { method: 'POST', body: formData });
            const data = await res.json();
            socket.emit('file-share', data);
        });

        // Admin Listeners
        socket.on('msg-deleted', () => location.reload());
        socket.on('user-banned', () => location.reload());

        // --- WebRTC Logic ---
        let localStream; let peers = {}; let isInCall = false; let isScreenSharing = false;

        socket.on('update-voice-list', (users) => {
            const div = document.getElementById('voice-users');
            div.innerHTML = users.map(u => `<div style="padding:4px 0; color:#ccc; font-size:13px;">${u}</div>`).join('');
        });

        async function joinVoiceChannel() {
            if(isInCall) return;
            closeSidebar();
            try {
                localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                document.getElementById('call-controls').classList.add('active');
                isInCall = true;
                socket.emit('join-voice');
                // New signaling logic (broadcast join)
                socket.emit('signal', { type: 'join-request', target: null });
                addVideoTile(localStream, username, true);
                playSound('join');
            } catch(e) { alert("Microphone error or permission denied."); }
        }

        async function toggleCamera() {
            if (!localStream) return;
            const videoTrack = localStream.getVideoTracks()[0];
            if (videoTrack && videoTrack.readyState === 'live') {
                videoTrack.stop(); localStream.removeTrack(videoTrack);
                document.getElementById('btn-cam').style.background = "rgba(255,255,255,0.1)";
                document.getElementById('btn-cam').style.color = "white";
                refreshMyTile();
            } else {
                if(isScreenSharing) await stopScreenShare();
                const s = await navigator.mediaDevices.getUserMedia({ video: true });
                const t = s.getVideoTracks()[0];
                localStream.addTrack(t);
                document.getElementById('btn-cam').style.background = "white";
                document.getElementById('btn-cam').style.color = "black";
                refreshMyTile();
                Object.values(peers).forEach(pc => { pc.addTrack(t, localStream); renegotiate(pc); });
            }
        }

        async function toggleScreen() {
            if(isScreenSharing) { stopScreenShare(); return; }
            try {
                const vidTrack = localStream.getVideoTracks()[0];
                if(vidTrack) { vidTrack.stop(); localStream.removeTrack(vidTrack); document.getElementById('btn-cam').style.background = "rgba(255,255,255,0.1)"; document.getElementById('btn-cam').style.color = "white"; }
                const s = await navigator.mediaDevices.getDisplayMedia({ video: true });
                const t = s.getVideoTracks()[0];
                t.onended = () => stopScreenShare();
                localStream.addTrack(t);
                isScreenSharing = true;
                document.getElementById('btn-screen').style.background = "white";
                document.getElementById('btn-screen').style.color = "black";
                refreshMyTile();
                Object.values(peers).forEach(pc => { pc.addTrack(t, localStream); renegotiate(pc); });
            } catch(e) {}
        }

        function stopScreenShare() {
            const t = localStream.getVideoTracks()[0];
            if(t) { t.stop(); localStream.removeTrack(t); }
            isScreenSharing = false;
            document.getElementById('btn-screen').style.background = "rgba(255,255,255,0.1)";
            document.getElementById('btn-screen').style.color = "white";
            refreshMyTile();
        }

        function toggleMic() {
            const t = localStream.getAudioTracks()[0];
            if(t) {
                t.enabled = !t.enabled;
                document.getElementById('btn-mic').style.color = t.enabled ? "white" : "#ff4757";
            }
        }

        function leaveVoiceChannel() {
            if(localStream) localStream.getTracks().forEach(t => t.stop());
            localStream = null; isInCall = false;
            Object.values(peers).forEach(p => p.close()); peers = {};
            document.getElementById('video-grid').classList.remove('active');
            document.getElementById('video-grid').innerHTML = '';
            document.getElementById('chat-area').style.display = 'flex';
            document.getElementById('call-controls').classList.remove('active');
            socket.emit('leave-voice');
        }

        // --- WebRTC Core ---
        async function renegotiate(pc) { 
            try {
                const o = await pc.createOffer(); 
                await pc.setLocalDescription(o); 
                socket.emit('signal', {type:'offer', sdp:o, target: pc.targetId}); 
            } catch(e) { console.error(e); }
        }

        function refreshMyTile() { addVideoTile(localStream, username, true); }
        
        function addVideoTile(stream, name, isMuted, id='me') {
            const grid = document.getElementById('video-grid');
            if(!grid.classList.contains('active')) { grid.classList.add('active'); document.getElementById('chat-area').style.display = 'none'; }
            const old = document.getElementById(`video-${id}`); if(old) old.remove();
            
            const card = document.createElement('div'); card.className = 'video-card'; card.id = `video-${id}`;
            const v = document.createElement('video'); v.srcObject = stream; v.autoplay = true; if(isMuted) v.muted = true; v.playsInline = true;
            
            const label = document.createElement('div');
            label.className = 'video-label';
            label.innerText = name;
            
            card.appendChild(v);
            card.appendChild(label);
            grid.appendChild(card);
        }

        // --- Socket Signal Handling ---
        socket.on('signal', async (d) => {
            if(d.senderUser === username) return;
            
            if(!peers[d.senderId]) { 
                peers[d.senderId] = createPeer(d.senderId, d.senderUser); 
            }
            const pc = peers[d.senderId];

            if(d.type === 'join-request') { 
                const o = await pc.createOffer(); 
                await pc.setLocalDescription(o); 
                socket.emit('signal', {type:'offer', sdp:o, target: d.senderId}); 
            }
            else if(d.type === 'offer') { 
                await pc.setRemoteDescription(d.sdp); 
                const a = await pc.createAnswer(); 
                await pc.setLocalDescription(a); 
                socket.emit('signal', {type:'answer', sdp:a, target: d.senderId}); 
            }
            else if(d.type === 'answer') await pc.setRemoteDescription(d.sdp);
            else if(d.type === 'candidate') pc.addIceCandidate(d.candidate);
        });

        socket.on('user-left-voice', (id) => {
            if(peers[id]) { peers[id].close(); delete peers[id]; }
            const el = document.getElementById(`video-${id}`); if(el) el.remove();
            if(document.getElementById('video-grid').children.length === 0) {
                 document.getElementById('video-grid').classList.remove('active');
                 document.getElementById('chat-area').style.display = 'flex';
            }
        });

        function createPeer(id, user) {
            const pc = new RTCPeerConnection({iceServers:[]});
            pc.targetId = id;
            
            if(localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
            
            pc.onicecandidate = e => { 
                if(e.candidate) socket.emit('signal', {type:'candidate', candidate:e.candidate, target:id}); 
            };
            
            pc.ontrack = e => {
                addVideoTile(e.streams[0], user, false, id);
            };
            
            pc.onnegotiationneeded = async () => { 
                try {
                    const o = await pc.createOffer(); 
                    await pc.setLocalDescription(o); 
                    socket.emit('signal', {type:'offer', sdp:o, target:id}); 
                } catch(e){}
            };
            return pc;
        }
    </script>
</body>
</html>